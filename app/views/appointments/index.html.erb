<div class="container-fluid px-4 py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="page-title mb-0">Schedule</h2>
    <%= link_to 'New Appointment', new_appointment_path, class: 'btn btn-gold' %>
  </div>

  <% if current_parent.appointments.any? %>
    <div class="card shadow-sm mb-4">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th>Chore</th>
              <th>Frequency</th>
              <th>Assigned To</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% current_parent.appointments.uniq.each do |appointment| %>
              <tr class="<%= 'table-success' if appointment.completed? %>">
                <td>
                  <% if appointment.completed? %>
                    <span class="text-decoration-line-through text-muted"><%= appointment.chore.job %></span>
                  <% else %>
                    <strong><%= appointment.chore.job %></strong>
                  <% end %>
                </td>
                <td><span class="badge bg-secondary"><%= appointment.frequency %></span></td>
                <td><%= render partial: 'children/convert2', locals: { children: appointment.chore.children } %></td>
                <td>
                  <% if appointment.completed? %>
                    <span class="badge bg-success">Done</span>
                  <% else %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% end %>
                </td>
                <td>
                  <div class="d-flex gap-2 justify-content-end">
                    <%= button_to appointment.completed? ? 'Undo' : 'Mark Done',
                                  toggle_complete_appointment_path(appointment),
                                  method: :patch,
                                  class: "btn btn-sm #{appointment.completed? ? 'btn-outline-secondary' : 'btn-outline-success'}" %>
                    <%= link_to 'View', appointment, class: 'btn btn-sm btn-gold' %>
                    <%= link_to 'Edit', edit_appointment_path(appointment), class: 'btn btn-sm btn-outline-secondary' %>
                    <%= button_to 'Delete', appointment, method: :delete,
                                  data: { confirm: 'Delete this appointment?' },
                                  class: 'btn btn-sm btn-outline-danger' %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-header fw-semibold">Weekly Calendar</div>
      <div class="card-body">
        <%= render 'display', appointment: current_parent.appointments %>
      </div>
    </div>

  <% else %>
    <div class="empty-state">
      <p class="text-muted">No appointments yet.</p>
      <%= link_to 'Create your first appointment', new_appointment_path, class: 'btn btn-gold mt-2' %>
    </div>
  <% end %>
</div>
