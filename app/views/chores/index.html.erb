<div class="container-fluid px-4 py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="page-title mb-0">Chores</h2>
    <%= link_to 'New Chore', new_chore_path, class: 'btn btn-gold' %>
  </div>

  <% if current_parent.chores.any? %>
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th>Chore</th>
              <th>Description</th>
              <th>Allowance</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% current_parent.chores.uniq.each do |chore| %>
              <tr>
                <td><strong><%= chore.job %></strong></td>
                <td class="text-muted"><%= chore.description %></td>
                <td>
                  <% if chore.allowance_amount > 0 %>
                    <span class="badge bg-success">$<%= sprintf('%.2f', chore.allowance_amount) %></span>
                  <% else %>
                    <span class="text-muted small">—</span>
                  <% end %>
                </td>
                <td>
                  <div class="d-flex gap-2 justify-content-end">
                    <%= link_to 'View', chore, class: 'btn btn-sm btn-gold' %>
                    <%= link_to 'Edit', edit_chore_path(chore), class: 'btn btn-sm btn-outline-secondary' %>
                    <%= button_to 'Delete', chore, method: :delete,
                                  data: { confirm: 'Delete this chore?' },
                                  class: 'btn btn-sm btn-outline-danger' %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="empty-state">
      <p class="text-muted">No chores added yet.</p>
      <%= link_to 'Add your first chore', new_chore_path, class: 'btn btn-gold mt-2' %>
    </div>
  <% end %>
</div>
