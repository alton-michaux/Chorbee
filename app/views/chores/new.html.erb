<div class="container-fluid px-4 py-4">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="d-flex align-items-center mb-3">
        <%= link_to '&larr; All Chores'.html_safe, chores_path, class: 'btn btn-sm btn-outline-secondary me-3' %>
        <h2 class="page-title mb-0">New Chore</h2>
      </div>
      <div class="card shadow-sm">
        <div class="card-body">
          <%= render 'form', chore: @chore %>
        </div>
      </div>
    </div>
  </div>
</div>
