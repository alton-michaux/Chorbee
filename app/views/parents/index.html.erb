<div class="container-fluid px-4 py-4">
  <h2 class="page-title mb-4">Dashboard</h2>

  <%# Stat cards %>
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="stat-label">Children</div>
        <div class="stat-value"><%= current_parent.children.count %></div>
        <%= link_to 'View all', children_path, class: 'stat-link' %>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="stat-label">Chores</div>
        <div class="stat-value"><%= current_parent.chores.count %></div>
        <%= link_to 'View all', chores_path, class: 'stat-link' %>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card stat-card--gold">
        <div class="stat-label">Total Balance Owed</div>
        <div class="stat-value">$<%= sprintf('%.2f', current_parent.children.sum(:balance)) %></div>
        <%= link_to 'View children', children_path, class: 'stat-link' %>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="stat-label">Pending Chores</div>
        <div class="stat-value"><%= current_parent.appointments.where(completed: false).count %></div>
        <%= link_to 'View schedule', appointments_path, class: 'stat-link' %>
      </div>
    </div>
  </div>

  <% if current_parent.children.any? %>
    <%# Quick-access dropdowns %>
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-header fw-semibold">Children</div>
          <div class="card-body">
            <ul class="list-unstyled mb-3">
              <% current_parent.children.each do |child| %>
                <li class="mb-1">
                  <%= link_to child.name, child_path(child), class: 'text-decoration-none' %>
                  <span class="badge bg-success float-end">$<%= sprintf('%.2f', child.balance) %></span>
                </li>
              <% end %>
            </ul>
            <%= link_to 'New Child', new_child_path, class: 'btn btn-sm btn-gold w-100' %>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-header fw-semibold">Chores</div>
          <div class="card-body">
            <ul class="list-unstyled mb-3">
              <% current_parent.chores.uniq.each do |chore| %>
                <li class="mb-1"><%= link_to chore.job, chore_path(chore), class: 'text-decoration-none' %></li>
              <% end %>
            </ul>
            <%= link_to 'New Chore', new_chore_path, class: 'btn btn-sm btn-gold w-100' %>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-header fw-semibold">Appointments</div>
          <div class="card-body">
            <ul class="list-unstyled mb-3">
              <% current_parent.appointments.uniq.each do |apt| %>
                <li class="mb-1 d-flex justify-content-between align-items-center">
                  <%= link_to apt.chore.job, appointment_path(apt), class: 'text-decoration-none' %>
                  <% if apt.completed? %>
                    <span class="badge bg-success">Done</span>
                  <% else %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
            <%= link_to 'New Appointment', new_appointment_path, class: 'btn btn-sm btn-gold w-100' %>
          </div>
        </div>
      </div>
    </div>

    <%# Chart %>
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">Chores per Child</div>
      <div class="card-body">
        <%= column_chart current_parent.children.joins(:chores).group(:'children.name').count,
                         legend: true, label: 'Chores', colors: ['#f5c518', '#0d6efd'],
                         loading: 'Loading…', empty: 'No data yet' %>
      </div>
    </div>

  <% else %>
    <div class="empty-state">
      <p class="text-muted">Get started by adding your first child.</p>
      <%= link_to 'Add a Child', new_child_path, class: 'btn btn-gold mt-2' %>
    </div>
  <% end %>
</div>
