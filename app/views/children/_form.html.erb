<%= form_for(child) do |f| %>
  <% if child.errors.any? %>
    <div class="alert alert-warning" id="error_explanation">
      <strong><%= pluralize(child.errors.count, 'error') %> prevented this child from being saved:</strong>
      <ul class="mb-0 mt-2">
        <% child.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: 'form-label fw-semibold' %>
    <%= f.text_field :name, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= f.label :age, class: 'form-label fw-semibold' %>
    <%= f.number_field :age, min: 1, max: 18, class: 'form-control' %>
  </div>

  <div class="mt-4">
    <%= f.submit class: 'btn btn-gold' %>
  </div>
<% end %>
