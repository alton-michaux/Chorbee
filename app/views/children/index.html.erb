<div class="container-fluid px-4 py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="page-title mb-0">Children</h2>
    <%= link_to 'New Child', new_child_path, class: 'btn btn-gold' %>
  </div>

  <% if current_parent.children.any? %>
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th>Name</th>
              <th>Age</th>
              <th>Chores</th>
              <th>Balance</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% current_parent.children.each do |child| %>
              <tr>
                <td><strong><%= child.name %></strong></td>
                <td><%= child.age %></td>
                <td>
                  <% if child.chores.present? %>
                    <%= render partial: 'chores/convert2', locals: { chores: child.chores } %>
                  <% else %>
                    <span class="text-muted">None</span>
                  <% end %>
                </td>
                <td>
                  <span class="badge bg-success fs-6">$<%= sprintf('%.2f', child.balance) %></span>
                </td>
                <td>
                  <div class="d-flex gap-2 justify-content-end">
                    <%= link_to 'View', child, class: 'btn btn-sm btn-gold' %>
                    <%= link_to 'Edit', edit_child_path(child), class: 'btn btn-sm btn-outline-secondary' %>
                    <%= button_to 'Delete', child, method: :delete,
                                  data: { confirm: 'Delete this child?' },
                                  class: 'btn btn-sm btn-outline-danger' %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="empty-state">
      <p class="text-muted">No children added yet.</p>
      <%= link_to 'Add your first child', new_child_path, class: 'btn btn-gold mt-2' %>
    </div>
  <% end %>
</div>
